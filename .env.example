# Copy to .env and fill in REAL random values (e.g. `openssl rand -hex 32`). Never commit .env.
BAYORA_AUTH_SECRET=
BAYORA_RED_WORKER_TOKEN=
BAYORA_BLUE_WORKER_TOKEN=
BAYORA_EVALUATOR_TOKEN=
BAYORA_ADAPTER_TOKEN=
# 1 = demo UI may pick a role (gateway signs a token for it). MUST be 0 in any real deployment.
BAYORA_DEV_HEADER_AUTH=0
BAYORA_TARGET_ADAPTER_MODE="MOCK_DETERMINISTIC_V1"
BAYORA_EXECUTION_TIMEOUT_MS="5000"
GEMINI_API_KEY=""
# Set to 1 ONLY if you accept sending payloads/defense rules to Google (needed for BAYORA_TARGET_ADAPTER_MODE=GEMINI_LIVE_V1)
BAYORA_ALLOW_EXTERNAL_MODEL=0
BAYORA_AUDIT_KEY=
# Set to 1 when the dashboard is served over HTTPS (adds the Secure flag to the session cookie)
BAYORA_COOKIE_SECURE=0
BAYORA_DISABLE_ROLE_CREDENTIALS=0
